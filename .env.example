# AlpoyyAternos environment template
# Copy to .env and fill with real values. Never commit .env.

# --- Web app (Next.js) ---
# SQLite/libSQL database URL. Local file default works for development.
DATABASE_URL="file:./data/alpoyy.db"
# Optional Turso/libSQL auth token for remote database.
DATABASE_AUTH_TOKEN=""

# Initial owner account created by `npm run db:seed`.
SEED_ADMIN_USERNAME="owner"
SEED_ADMIN_PASSWORD="change-this-to-a-long-random-password"

# Default bot configuration seeded into the database.
SEED_SERVER_HOST=""
SEED_SERVER_PORT="25565"
SEED_SERVER_VERSION="1.21.11"
SEED_BOT_USERNAME="AlpoyyBot"
SEED_WORKER_ENDPOINT="http://127.0.0.1:8787"

# Shared secret used to sign dashboard <-> worker requests. Must match worker.
# Generate with: openssl rand -hex 32
WORKER_SHARED_SECRET="replace-with-a-random-64-char-secret"
WORKER_KEY_ID="alpoyy-web"
WORKER_PUSH_KEY_ID="alpoyy-worker"
# Dashboard URL reachable by the worker for state push callbacks.
WORKER_DASHBOARD_URL="http://127.0.0.1:3000"

# --- Persistent worker ---
WORKER_HOST="0.0.0.0"
WORKER_PORT="8787"
WORKER_ENDPOINT="http://127.0.0.1:8787"
WORKER_LOG_LEVEL="info"

# Node environment
NODE_ENV="development"
